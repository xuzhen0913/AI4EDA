{
  "circuit": "two_stage_opamp",
  "process": "sky130",
  "corner": "tt",
  "conditions": {
    "vdd_v": 1.8,
    "temperature_c": 27,
    "input_common_mode_v": 0.9,
    "load_capacitance_f": 2e-12
  },
  "targets": {
    "dc_gain_db": {
      "min": 60
    },
    "ugb_hz": {
      "min": 10000000
    },
    "phase_margin_deg": {
      "min": 60
    },
    "power_w": {
      "max": 0.0005
    }
  },
  "optimization": {
    "max_iterations": 10,
    "allowed_parameters": [
      "W_IN",
      "L_IN",
      "W_LOAD",
      "L_LOAD",
      "W_STAGE2",
      "L_STAGE2",
      "WBN0",
      "L_BIAS_N",
      "WBP0",
      "L_BIAS_P",
      "IBIAS",
      "CC",
      "N_TAIL",
      "N_STAGE2_LOAD"
    ],
    "parameter_bounds": {
      "W_IN": {
        "min_um": 1.0,
        "max_um": 100.0
      },
      "L_IN": {
        "min_um": 0.15,
        "max_um": 2.0
      },
      "W_LOAD": {
        "min_um": 1.0,
        "max_um": 100.0
      },
      "L_LOAD": {
        "min_um": 0.15,
        "max_um": 2.0
      },
      "W_STAGE2": {
        "min_um": 1.0,
        "max_um": 200.0
      },
      "L_STAGE2": {
        "min_um": 0.15,
        "max_um": 2.0
      },
      "L_BIAS_N": {
        "min_um": 0.15,
        "max_um": 2.0
      },
      "L_BIAS_P": {
        "min_um": 0.15,
        "max_um": 2.0
      },
      "IBIAS": {
        "min_a": 1e-06,
        "max_a": 0.0001
      },
      "CC": {
        "min_f": 1e-13,
        "max_f": 1e-11
      },
      "WBN0": {
        "min_um": 1.0,
        "max_um": 100.0
      },
      "WBP0": {
        "min_um": 1.0,
        "max_um": 100.0
      },
      "N_TAIL": {
        "min": 1,
        "max": 20
      },
      "N_STAGE2_LOAD": {
        "min": 1,
        "max": 20
      }
    },
    "matching_constraints": [
      {
        "devices": [
          "XM1",
          "XM2"
        ],
        "shared_parameters": [
          "W_IN",
          "L_IN"
        ],
        "description": "Differential input pair must remain matched."
      },
      {
        "devices": [
          "XM3",
          "XM4"
        ],
        "shared_parameters": [
          "W_LOAD",
          "L_LOAD"
        ],
        "description": "PMOS mirror M3/M4 must have identical W and L (fixed 1:1)."
      }
    ],
    "max_dc_iterations": 5,
    "integer_parameters": [
      "N_TAIL",
      "N_STAGE2_LOAD"
    ],
    "device_dimensions": {
      "XM1": {
        "W": "W_IN",
        "L": "L_IN"
      },
      "XM2": {
        "W": "W_IN",
        "L": "L_IN"
      },
      "XM3": {
        "W": "W_LOAD",
        "L": "L_LOAD"
      },
      "XM4": {
        "W": "W_LOAD",
        "L": "L_LOAD"
      },
      "XMBIAS_N": {
        "W": "WBN0",
        "L": "L_BIAS_N"
      },
      "XM5": {
        "W": "N_TAIL*WBN0",
        "L": "L_BIAS_N"
      },
      "XMBIAS_P": {
        "W": "WBP0",
        "L": "L_BIAS_P"
      },
      "XM7": {
        "W": "N_STAGE2_LOAD*WBP0",
        "L": "L_BIAS_P"
      },
      "XM6": {
        "W": "W_STAGE2",
        "L": "L_STAGE2"
      }
    },
    "device_bounds": {
      "XM1": {
        "min_w_um": 1,
        "max_w_um": 100,
        "min_l_um": 0.15,
        "max_l_um": 2
      },
      "XM2": {
        "min_w_um": 1,
        "max_w_um": 100,
        "min_l_um": 0.15,
        "max_l_um": 2
      },
      "XM3": {
        "min_w_um": 1,
        "max_w_um": 100,
        "min_l_um": 0.15,
        "max_l_um": 2
      },
      "XM4": {
        "min_w_um": 1,
        "max_w_um": 100,
        "min_l_um": 0.15,
        "max_l_um": 2
      },
      "XMBIAS_N": {
        "min_w_um": 1,
        "max_w_um": 100,
        "min_l_um": 0.15,
        "max_l_um": 2
      },
      "XM5": {
        "min_w_um": 1,
        "max_w_um": 100,
        "min_l_um": 0.15,
        "max_l_um": 2
      },
      "XMBIAS_P": {
        "min_w_um": 1,
        "max_w_um": 100,
        "min_l_um": 0.15,
        "max_l_um": 2
      },
      "XM7": {
        "min_w_um": 1,
        "max_w_um": 200,
        "min_l_um": 0.15,
        "max_l_um": 2
      },
      "XM6": {
        "min_w_um": 1,
        "max_w_um": 200,
        "min_l_um": 0.15,
        "max_l_um": 2
      }
    },
    "mirror_constraints": [
      {
        "reference": "XM3",
        "output": "XM4",
        "fixed_ratio": 1
      },
      {
        "reference": "XMBIAS_N",
        "output": "XM5",
        "ratio": "N_TAIL"
      },
      {
        "reference": "XMBIAS_P",
        "output": "XM7",
        "ratio": "N_STAGE2_LOAD"
      }
    ]
  },
  "report": {
    "generate_pdf": true,
    "filename": "final_report.pdf",
    "required_sections": [
      "optimized_netlist",
      "circuit_topology",
      "final_performance",
      "optimization_iterations",
      "simulation_count",
      "optimization_time",
      "token_usage"
    ]
  },
  "dc_acceptance": {
    "minimum_drain_current_a": 1e-09,
    "minimum_overdrive_v": 0.0,
    "minimum_saturation_margin_v": 0.0,
    "devices": {
      "XM1": {
        "kind": "nfet",
        "drain": "n1",
        "gate": "vinp",
        "source": "ntail"
      },
      "XM2": {
        "kind": "nfet",
        "drain": "n2",
        "gate": "vinn",
        "source": "ntail"
      },
      "XM3": {
        "kind": "pfet",
        "drain": "n1",
        "gate": "n1",
        "source": "vdd"
      },
      "XM4": {
        "kind": "pfet",
        "drain": "n2",
        "gate": "n1",
        "source": "vdd"
      },
      "XMBIAS_N": {
        "kind": "nfet",
        "drain": "vbias_n",
        "gate": "vbias_n",
        "source": "0"
      },
      "XM5": {
        "kind": "nfet",
        "drain": "ntail",
        "gate": "vbias_n",
        "source": "0"
      },
      "XMBIAS_P": {
        "kind": "pfet",
        "drain": "vbias_p",
        "gate": "vbias_p",
        "source": "vdd"
      },
      "XM7": {
        "kind": "pfet",
        "drain": "out",
        "gate": "vbias_p",
        "source": "vdd"
      },
      "XM6": {
        "kind": "nfet",
        "drain": "out",
        "gate": "n2",
        "source": "0"
      }
    }
  }
}
